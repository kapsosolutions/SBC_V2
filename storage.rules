rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Notification images
    // Only authenticated users can upload/read notification images.
    match /notification-images/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Everything else remains protected.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
