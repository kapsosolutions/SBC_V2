# ============================================================
# SBC Backend — environment template
# Copy to `.env` for local dev, or set these in the Render dashboard.
# ============================================================

NODE_ENV=production
PORT=8080

# Comma-separated list of allowed frontend origins (CORS).
# Supports wildcards, e.g. https://*.vercel.app for preview deployments.
# e.g. https://your-app.vercel.app,https://*.vercel.app,https://www.studentbenefitcard.com
FRONTEND_ORIGIN=http://localhost:3000

# ---- Firebase Admin (service account) ----
FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Preferred: base64-encoded PEM. Generate with:
#   node -e "console.log(Buffer.from(require('fs').readFileSync('key.pem','utf8')).toString('base64'))"
FIREBASE_ADMIN_PRIVATE_KEY_BASE64=
# Alternative to the base64 var: raw PEM (escape newlines as \n).
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ---- Push notification links ----
APP_PUBLIC_URL=https://www.studentbenefitcard.com
NOTIFICATION_ICON_URL=https://www.studentbenefitcard.com/sbc-notification-icon.png
